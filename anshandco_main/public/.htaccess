# ============================================================================
# ANSH&CO (anshandco.com) — Apache / LiteSpeed (Hostinger) Configuration
# Supports:
# 1. RFC 8288 Link Response Headers for AI Agents & Crawlers
# 2. Content Negotiation: Serve Markdown (text/markdown) when Accept: text/markdown
# 3. SEP-1649 MCP Server Card at /.well-known/mcp/server-card.json
# 4. SPA Clean URL Routing (/about, /contact, /terms, /privacy)
# ============================================================================

<IfModule mod_mime.c>
  AddType text/markdown .md
  AddCharset UTF-8 .md .txt .json .xml
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  AddType image/x-icon .ico
  AddType image/svg+xml .svg
  AddType image/webp .webp
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Advertise AI / Agent discovery resources via RFC 8288 Link Header
  Header set Link "<https://anshandco.com/llms.txt>; rel=\"llms-txt\"; type=\"text/plain\", <https://anshandco.com/llms-full.txt>; rel=\"alternate\"; type=\"text/plain\"; title=\"ANSH&CO Full Knowledge Base\", <https://anshandco.com/index.md>; rel=\"alternate\"; type=\"text/markdown\"; title=\"ANSH&CO Markdown Representation\", <https://anshandco.com/.well-known/mcp/server-card.json>; rel=\"mcp-server-card\"; type=\"application/json\", <https://anshandco.com/sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\""
  Header merge Vary "Accept"
  Header set X-Content-Signal "search=yes, ai-input=yes, ai-train=no"
  Header set Access-Control-Allow-Origin "*"

  <FilesMatch "\.(md)$">
    Header set Content-Type "text/markdown; charset=utf-8"
  </FilesMatch>

  <FilesMatch "server-card\.json$">
    Header set Content-Type "application/json; charset=utf-8"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 0. Force 301 Permanent Redirect from www.anshandco.com to canonical https://anshandco.com
  RewriteCond %{HTTP_HOST} ^www\.anshandco\.com$ [NC]
  RewriteRule ^(.*)$ https://anshandco.com/$1 [L,R=301]

  # 1. Serve Markdown representation when an AI agent requests Accept: text/markdown on Homepage
  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteCond %{REQUEST_URI} ^/(index\.html)?$ [NC]
  RewriteRule ^.*$ /index.md [L,T=text/markdown;charset=UTF-8]

  # 2. Allow direct access to .well-known files (including /.well-known/mcp/server-card.json)
  RewriteRule ^\.well-known/ - [L]

  # 3. Serve index.html directly with 200 OK (no 301 trailing-slash redirect) when requesting a pre-rendered directory URL
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]

  # 4. Allow existing files
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 5. SPA Fallback to index.html
  RewriteRule ^ /index.html [L]
</IfModule>
